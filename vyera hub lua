col(p,t,s)
local h=p.Parent
if h then
col(h,t,s)
local n=0
for _,d in ipairs(h:GetDescendants())do n=n+1 if n>150 then break end col(d,t,s)end
local pos=pp(p)
if pos then
local ok2,hits=pcall(function()return workspace:GetPartBoundsInRadius(pos,10,OverlapParams.new())end)
if ok2 and hits then
