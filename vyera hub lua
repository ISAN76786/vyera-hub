local function walk(tgt,my)
local h,r=hum(),root()
if not h or not r then return false end
local path=PS:CreatePath({AgentRadius=2.5,AgentHeight=5,AgentCanJump=true,WaypointSpacing=8})
local ok2=pcall(function()path:ComputeAsync(r.Position,tgt)end)
local wps
if ok2 and path.Status==Enum.PathStatus.Success then wps=path:GetWaypoints()else wps={{Position=tgt,Action=Enum.PathWaypointAction.Walk}}end
for _,wp in ipairs(wps)do
h,r=hum(),root()
if not h or not r or h.Health<=0 or S.tok~=my then return false end
if wp.Action==Enum.PathWaypointAction.Jump then h.Jump=true end
h:MoveTo(wp.Position)
local t1,lc,l2=os.clock(),r.Position,os.clock()
while fl(wp.Position,r.Position)>math.max(3.5,h.WalkSpeed*.1)and os.clock()-t1<3 do
task.wait(.1)
h,r=hum(),root()
if not h or not r or h.Health<=0 or S.tok~=my then return false end
if os.clock()-l2>.8 then
if(r.Position-lc).Magnitude<1 then h.Jump=true end
lc,l2=r.Position,os.clock()
end
end
end
return true
end
local function go(pos,lab)
local h,r=hum(),root()
if not h or not r or h.Health<=0 then return false end
S.tok=S.tok+1
local my=S.tok
if S.tp then S.ign=os.clock()+1.5 r.CFrame=CFrame.new(pos+Vector3.new(0,3,0))task.wait(.3)return true end
local d0=math.max(fl(pos,r.Position),1)
local t0=os.clock()
local tries=0
while true do
h,r=hum(),root()
if not h or not r or h.Health<=0 or S.tok~=my then return false end
local d=fl(pos,r.Position)
prog(1-d/d0)
if d<math.max(5,h.WalkSpeed*.12)then prog(1)return true end
if os.clock()-t0>d0/math.max(h.WalkSpeed,8)*2+45 then return false end
if lab then st(lab.." ("..math.floor(d).." stud)",AMB)end
local dir=Vector3.new(pos.X-r.Position.X,0,pos.Z-r.Position.Z).Unit
local tgt=pos
if d>150 then tgt=Vector3.new(r.Position.X+dir.X*150,r.Position.Y,r.Position.Z+dir.Z*150)end
local before=r.Position
walk(tgt,my)
h,r=hum(),root()
if not h or not r or h.Health<=0 or S.tok~=my then return false end
if(r.Position-before).Magnitude<3 then
tries=tries+1
if tries>=3 then return false end
local sd=dir:Cross(Vector3.new(0,1,0))*(tries%2==0 and 14 or -14)
h:MoveTo(r.Position+sd)
h.Jump=true
task.wait(.8)
else tries=0 end
end
end
