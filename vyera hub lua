local function pathfindWalk(targetPos, currentToken)
    local humanoid, rootPart = getHumanoid(), getRootPart()
    if not humanoid or not rootPart then return false end
    
    local path = PathfindingService:CreatePath({AgentRadius=2.5, AgentHeight=5, AgentCanJump=true, WaypointSpacing=8})
    local success = pcall(function() path:ComputeAsync(rootPart.Position, targetPos) end)
    
    local waypoints
    if success and path.Status == Enum.PathStatus.Success then 
        waypoints = path:GetWaypoints()
    else 
        waypoints = {{Position = targetPos, Action = Enum.PathWaypointAction.Walk}}
    end
    
    for _, waypoint in ipairs(waypoints) do
        humanoid, rootPart = getHumanoid(), getRootPart()
        if not humanoid or not rootPart or humanoid.Health <= 0 or Config.token ~= currentToken then return false end
        
        if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(waypoint.Position)
        
        local startTime, lastCheckPos, lastCheckTime = os.clock(), rootPart.Position, os.clock()
        while getFlatDistance(waypoint.Position, rootPart.Position) > math.max(3.5, humanoid.WalkSpeed * 0.1) and os.clock() - startTime < 3 do
            task.wait(0.1)
            humanoid, rootPart = getHumanoid(), getRootPart()
            if not humanoid or not rootPart or humanoid.Health <= 0 or Config.token ~= currentToken then return false end
            
            if os.clock() - lastCheckTime > 0.8 then
                if (rootPart.Position - lastCheckPos).Magnitude < 1 then humanoid.Jump = true end
                lastCheckPos, lastCheckTime = rootPart.Position, os.clock()
            end
        end
    end
    return true
end

local function moveToTarget(targetPos, label)
    local humanoid, rootPart = getHumanoid(), getRootPart()
    if not humanoid or not rootPart or humanoid.Health <= 0 then return false end
    
    Config.token = Config.token + 1
    local currentToken = Config.token
    
    if Config.teleport then 
        Config.ignoreTime = os.clock() + 1.5 
        rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0,3,0))
        task.wait(0.3)
        return true 
    end
    
    local initialDist = math.max(getFlatDistance(targetPos, rootPart.Position), 1)
    local startTime = os.clock()
    local stuckTries = 0
    
    while true do
        humanoid, rootPart = getHumanoid(), getRootPart()
        if not humanoid or not rootPart or humanoid.Health <= 0 or Config.token ~= currentToken then return false end
        
        local currentDist = getFlatDistance(targetPos, rootPart.Position)
        updateProgress(1 - currentDist/initialDist)
        
        if currentDist < math.max(5, humanoid.WalkSpeed * 0.12) then updateProgress(1) return true end
        if os.clock() - startTime > initialDist / math.max(humanoid.WalkSpeed, 8) * 2 + 45 then return false end
        if label then updateStatus(label .. " (" .. math.floor(currentDist) .. " stud)", ColorAmber) end
        
        local dir = Vector3.new(targetPos.X - rootPart.Position.X, 0, targetPos.Z - rootPart.Position.Z).Unit
        local intermediateTgt = targetPos
        if currentDist > 150 then intermediateTgt = Vector3.new(rootPart.Position.X + dir.X*150, rootPart.Position.Y, rootPart.Position.Z + dir.Z*150) end
        
        local posBeforeWalk = rootPart.Position
        pathfindWalk(intermediateTgt, currentToken)
        
        humanoid, rootPart = getHumanoid(), getRootPart()
        if not humanoid or not rootPart or humanoid.Health <= 0 or Config.token ~= currentToken then return false end
        
        if (rootPart.Position - posBeforeWalk).Magnitude < 3 then
            stuckTries = stuckTries + 1
            if stuckTries >= 3 then return false end
            local sideDir = dir:Cross(Vector3.new(0,1,0)) * (stuckTries % 2 == 0 and 14 or -14)
            humanoid:MoveTo(rootPart.Position + sideDir)
            humanoid.Jump = true
            task.wait(0.8)
        else 
            stuckTries = 0 
        end
    end
end

local function stopMovement()
    Config.token = Config.token + 1 
    local humanoid, rootPart = getHumanoid(), getRootPart()
    if humanoid and rootPart then humanoid:MoveTo(rootPart.Position) end 
    updateProgress(0)
end

local function getPromptPosition(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("Attachment") then return parent.WorldPosition end
    if parent:IsA("BasePart") then return parent.Position end
    if parent:IsA("Model") then return parent:GetPivot().Position end
    return nil
end

local function collectInfo(instance, textTable, seenTable)
    if seenTable[instance] then return end
    seenTable[instance] = true
    textTable[#textTable+1] = instance.Name
    for key, val in pairs(instance:GetAttributes()) do textTable[#textTable+1] = tostring(key) .. " " .. tostring(val) end
    if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then 
        textTable[#textTable+1] = instance.Text 
    elseif instance:IsA("StringValue") then 
        textTable[#textTable+1] = instance.Value 
    end
end

local function parseEggInfo(prompt)
    local cached = infoCache[prompt]
    if cached and os.clock() - cached.time < 8 then return cached.text end
    
    local textTable, seenTable = {}, {}
    collectInfo(prompt, textTable, seenTable)
    local parent = prompt.Parent
    
    if parent then
        collectInfo(parent, textTable, seenTable)
        local count = 0
        for _, desc in ipairs(parent:GetDescendants()) do 
            count = count + 1 
            if count > 150 then break end 
            collectInfo(desc, textTable, seenTable)
        end
        local pos = getPromptPosition(prompt)
        if pos then
            local ok2, hits = pcall(function() return workspace:GetPartBoundsInRadius(pos, 10, OverlapParams.new()) end)
            if ok2 and hits then
                local modelsSeen, modelCount = {}, 0
                for _, hitPart in ipairs(hits) do
                    for _, gui in ipairs(hitPart:GetChildren()) do 
                        if gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then 
                            collectInfo(gui, textTable, seenTable)
                            for _, desc in ipairs(gui:GetDescendants()) do collectInfo(desc, textTable, seenTable) end 
                        end 
                    end
                    local model = hitPart:FindFirstAncestorOfClass("Model")
                    if model and model ~= workspace and not modelsSeen[model] and not model:FindFirstChildOfClass("Humanoid") and #model:GetChildren() <= 40 then
                        modelsSeen[model] = true
                        modelCount = modelCount + 1
                        if modelCount > 6 then break end
                        collectInfo(model, textTable, seenTable)
                        local k = 0
                        for _, desc in ipairs(model:GetDescendants()) do 
                            k = k + 1 
                            if k > 120 then break end 
                            collectInfo(desc, textTable, seenTable)
                        end
                    end
                end
            end
        end
    end
    
    local finalString = string.lower(table.concat(textTable, " "))
    infoCache[prompt] = {time = os.clock(), text = finalString}
    return finalString
end

local function hasWord(text, word)
    word = string.lower(word):gsub("%p", "%%%0")
    return string.find(text, "%f[%w]" .. word .. "%f[%W]") ~= nil 
end

local function isFilterActive()
    for _, active in pairs(Config.rarities) do if active then return true end end 
    return #Config.keywords > 0 
end

local function matchesFilter(prompt)
    if not isFilterActive() then return true end
    local infoText = parseEggInfo(prompt)
    for rarity, active in pairs(Config.rarities) do 
        if active and hasWord(infoText, rarity) then return true end 
    end
    for _, keyword in ipairs(Config.keywords) do 
        if hasWord(infoText, keyword) then return true end 
    end
    return false
end

local function detectRarity(prompt)
    local infoText = parseEggInfo(prompt)
    for _, rarityName in ipairs(RARITY_LIST) do 
        if hasWord(infoText, rarityName) then return rarityName end 
    end 
    return nil 
end

local function findNearestEgg(ignoreFilter, ignoreCooldown)
    local rootPart = getRootPart()
    if not rootPart then return nil end
    local bestFilteredEgg, bestFilteredDist, bestFallbackEgg, bestFallbackDist
    
    for _, part in ipairs(workspace:GetChildren()) do
        if part.Name == "SmartPromptPart" then
            local prompt = part:FindFirstChild("CarryAreaEgg")
            if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and prompt.ActionText == "Steal" then
                local pos = getPromptPosition(prompt)
                if pos and (ignoreCooldown or not lastTime[prompt] or os.clock() - lastTime[prompt] > 6) then
                    local dist = (pos - rootPart.Position).Magnitude
                    if dist <= Config.maxDistance then
                        if not bestFallbackDist or dist < bestFallbackDist then 
                            bestFallbackEgg, bestFallbackDist = prompt, dist 
                        end
                        if (not bestFilteredDist or dist < bestFilteredDist) and (ignoreFilter or matchesFilter(prompt)) then 
                            bestFilteredEgg, bestFilteredDist = prompt, dist 
                        end
                    end
                end
            end
        end
    end
    
    if bestFilteredEgg then return bestFilteredEgg end
    if Config.fallback then return bestFallbackEgg end
    return nil
end

local function autoStealCycle()
    local humanoid, rootPart = getHumanoid(), getRootPart()
    if not humanoid or not rootPart or humanoid.Health <= 0 then 
        updateStatus("Menunggu respawn...", ColorAmber) 
        updateProgress(0) 
        return 
    end
    
    local targetEgg = findNearestEgg(false, false)
    if not targetEgg then 
        updateStatus("Tidak ada egg sesuai filter", ColorAmber) 
        updateProgress(0) 
        return 
    end
    
    lastTime[targetEgg] = os.clock()
    local targetPos = getPromptPosition(targetEgg)
    if not targetPos then return end
    
    local eggRarity = detectRarity(targetEgg)
    if isFilterActive() and not matchesFilter(targetEgg) then 
        updateStatus("Rarity pilihan tidak ada, ambil egg lain", ColorAmber) 
        task.wait(0.5)
    end
    
    if not moveToTarget(targetPos, "Egg " .. (eggRarity or "?")) then
        if not Config.isAutoSteal then return end
        lastTime[targetEgg] = os.clock() + 24
        Config.skipCount = Config.skipCount + 1
        Config.failCount = Config.failCount + 1
        updateCounters()
        updateStatus("Nyangkut, skip egg ini", ColorRed)
        
        if Config.autoReset and Config.failCount >= 2 then
            Config.failCount = 0
            updateStatus("Reset karakter (nyangkut)", ColorRed)
            local hum2 = getHumanoid()
            if hum2 then hum2.Health = 0 end
            task.wait(5)
        end
        return
    end
    
    if not Config.isAutoSteal then return end
    if not fireproximityprompt then 
        Config.isAutoSteal = false 
        updateStatus("Executor tidak support prompt", ColorRed) 
        return 
    end
    
    updateStatus("Mengambil egg...", ColorGreen)
    fireproximityprompt(targetEgg)
    task.wait(0.8)
    
    local function isEggTaken() return not targetEgg.Parent or not targetEgg.Enabled or targetEgg.ActionText ~= "Steal" end
    local gotEgg = isEggTaken()
    
    if not gotEgg then 
        fireproximityprompt(targetEgg) 
        task.wait(0.8) 
        gotEgg = isEggTaken() 
    end
    
    if gotEgg then 
        Config.eggCount = Config.eggCount + 1 
        updateCounters() 
    end
    
    -- TWEEN MODIFICATION UNTUK KEMBALI KE BASE
    if Config.basePosition then
        updateStatus("Tweening ke base...", ColorAmber)
        local rp = getRootPart()
        if rp then
            local dist = (Config.basePosition.Position - rp.Position).Magnitude
            -- 150 adalah kecepatan ditarik (bisa diubah)
            local twInfo = TweenInfo.new(dist / 150, Enum.EasingStyle.Linear)
            local tw = TweenService:Create(rp, twInfo, {CFrame = CFrame.new(Config.basePosition.Position + Vector3.new(0, 3, 0))})
            tw:Play()
            tw.Completed:Wait()
            Config.failCount = 0 
            updateStatus("Sampai di base", ColorGreen)
        else
            Config.failCount = Config.failCount + 1 
            updateStatus("Gagal kembali ke base", ColorRed)
        end
    else 
        updateStatus("Base belum di-set!", ColorRed)
    end
end

