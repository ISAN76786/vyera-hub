end
local function col(i,t,s)
if s[i]then return end
s[i]=true
t[#t+1]=i.Name
for k,v in pairs(i:GetAttributes())do t[#t+1]=tostring(k).." "..tostring(v)end
if i:IsA("TextLabel")or i:IsA("TextButton")or i:IsA("TextBox")then t[#t+1]=i.Text elseif i:IsA("StringValue")then t[#t+1]=i.Value end
end
local function info(p)
