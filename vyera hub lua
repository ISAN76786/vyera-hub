local function pp(p)
local a=p.Parent
if not a then return nil end
if a:IsA("Attachment")then return a.WorldPosition end
if a:IsA("BasePart")then return a.Position end
if a:IsA("Model")then return a:GetPivot().Position end
return nil
end
local function col(i,t,s)
if s[i]then return end
s[i]=true
t[#t+1]=i.Name
for k,v in pairs(i:GetAttributes())do t[#t+1]=tostring(k).." "..tostring(v)end
if i:IsA("TextLabel")or i:IsA("TextButton")or i:IsA("TextBox")then t[#t+1]=i.Text elseif i:IsA("StringValue")then t[#t+1]=i.Value end
end
local function info(p)
local c=ic[p]
if c and os.clock()-c.t<8 then return c.x end
local t,s={},{}
col(p,t,s)
local h=p.Parent
if h then
col(h,t,s)
local n=0
for _,d in ipairs(h:GetDescendants())do n=n+1 if n>150 then break end col(d,t,s)end
local pos=pp(p)
if pos then
local ok2,hits=pcall(function()return workspace:GetPartBoundsInRadius(pos,10,OverlapParams.new())end)
if ok2 and hits then
local ms,cnt={},0
for _,b in ipairs(hits)do
