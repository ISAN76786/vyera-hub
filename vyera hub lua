for _,b in ipairs(hits)do
for _,g in ipairs(b:GetChildren())do if g:IsA("BillboardGui")or g:IsA("SurfaceGui")then col(g,t,s)for _,d in ipairs(g:GetDescendants())do col(d,t,s)end end end
local m=b:FindFirstAncestorOfClass("Model")
if m and m~=workspace and not ms[m]and not m:FindFirstChildOfClass("Humanoid")and #m:GetChildren()<=40 then
ms[m]=true
cnt=cnt+1
if cnt>6 then break end
col(m,t,s)
local k=0
for _,d in ipairs(m:GetDescendants())do k=k+1 if k>120 then break end col(d,t,s)end
end
end
end
end
end
local x=string.lower(table.concat(t," "))
